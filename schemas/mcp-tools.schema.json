{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum-memory.invalid/schemas/mcp-tools.schema.json",
  "title": "Continuum Memory model-facing tool inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": {"const": 1},
    "tools": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "inputSchema"],
        "properties": {
          "name": {
            "enum": [
              "memory_context",
              "memory_search",
              "memory_get",
              "memory_propose",
              "memory_feedback",
              "memory_status"
            ]
          },
          "inputSchema": {"type": "object"}
        }
      }
    }
  }
}
