<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Continuum Memory</vendor>
  <vendor_url>https://github.com/Oussamoux1234/continuum-memory</vendor_url>
  <action id="org.continuummemory.approval">
    <description>Approve a Continuum Memory administrative operation</description>
    <message>Administrator authentication is required for this Continuum Memory approval</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/continuum-memory/approval-helper</annotate>
  </action>
</policyconfig>
